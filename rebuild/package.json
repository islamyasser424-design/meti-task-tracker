{
  "name": "meti-turso-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir .build",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/browser.mjs",
    "test:runtime": "node --test test/runtime.integration.mjs",
    "test:dom": "node --experimental-vm-modules test/dom.integration.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "migrate": "node scripts/migrate.mjs",
    "user": "node scripts/user.mjs",
    "import": "node scripts/import-archive.mjs",
    "backup": "node scripts/backup.mjs",
    "monitor": "node scripts/monitor.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "miniflare": "5.20261023.1-beta",
    "playwright": "1.62.1",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24.0"
  }
}
