{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meti-turso-review",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "METI", "class_name": "MetiCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MetiCoordinator"] }],
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "production" },
}
